<?xml version="1.0" encoding="utf-8"?>
<!--
  Keep the native launch window deliberately minimal. The previous bitmap used
  its intrinsic pixel size on some OEM launchers and briefly filled most of the
  screen. Flutter paints the branded UI immediately afterwards, so a neutral
  background avoids a stretched/oversized logo flash during startup.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />
</layer-list>
